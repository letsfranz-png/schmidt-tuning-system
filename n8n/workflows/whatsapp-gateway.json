    },
    {
      "parameters": {
        "jsCode": "const payload = $json.body || $json;\\nconst value = payload?.entry?.[0]?.changes?.[0]?.value || {};\\nconst message = value.messages?.[0] || null;\\nconst contact = value.contacts?.[0] || null;\\nreturn [{ json: { receivedAt: new Date().toISOString(), eventType: message ? 'message' : (value.statuses ? 'status' : 'unknown'), messageId: message?.id || null, from: message?.from || null, customerName: contact?.profile?.name || null, messageType: message?.type || null, text: message?.text?.body || null, timestamp: message?.timestamp || null, raw: payload } }];"
      },
      "id": "normalize-event",
      "name": "Ereignis normalisieren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
